rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the caller is an authenticated teacher/admin for this school
    function isTeacherOrAdmin(schoolId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    // Helper: profilo dell'utente che fa la richiesta
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdminOf(schoolId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && me().schoolId == schoolId
        && me().role == 'admin';
    }
    // Conto (ledger) del docente: chi non ha il campo ledgerId usa il conto storico 'main'
    function ownsLedger(schoolId, ledgerId) {
      return isTeacherOrAdmin(schoolId) && me().get('ledgerId', 'main') == ledgerId;
    }

    // Users collection: public read (teacher names/roles needed by student pages).
    // Only teachers/admins can write.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && isTeacherOrAdmin(request.resource.data.schoolId);
    }

    match /schools/{schoolId} {
      // School config: anyone can read (needed for public student pages)
      allow read: if true;
      allow write: if isTeacherOrAdmin(schoolId);

      // All subcollections inside a school:
      //   - public read (student pages need students, rewards, transactions, classes)
      //   - only teachers/admins can write
      // Exceptions below override this for rewardRequests.
      match /{collection}/{docId} {
        allow read: if true;
        // 'ledgers' (conti dei docenti) ha regole proprie qui sotto
        allow write: if collection != 'ledgers' && isTeacherOrAdmin(schoolId);
      }

      // Conti dei docenti (nome, materia, colore, valuta, lingua, classi, NB check, compiti):
      //   - lettura pubblica: la pagina alunno ne ha bisogno
      //   - l'admin modifica tutto
      //   - un docente può cambiare SOLO le impostazioni check/compiti del proprio conto
      match /ledgers/{ledgerId} {
        allow read: if true;
        allow create, delete: if isAdminOf(schoolId);
        allow update: if isAdminOf(schoolId)
          || (ownsLedger(schoolId, ledgerId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nb', 'hw', 'ownerUid', 'updatedAt']));
      }

      // Reward requests:
      //   - ANY authenticated user (including anonymous) can CREATE
      //   - Only teachers/admins can read, update, delete
      match /rewardRequests/{requestId} {
        allow create: if request.auth != null;
        allow read, update, delete: if isTeacherOrAdmin(schoolId);
      }
    }
  }
}
