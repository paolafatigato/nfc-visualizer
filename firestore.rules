rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the caller is an authenticated teacher/admin for this school
    function isTeacherOrAdmin(schoolId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'admin'];
    }

    // Users collection: public read (teacher names/roles needed by student pages).
    // Only teachers/admins can write.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && isTeacherOrAdmin(request.resource.data.schoolId);
    }

    match /schools/{schoolId} {
      // School config: anyone can read (needed for public student pages)
      allow read: if true;
      allow write: if isTeacherOrAdmin(schoolId);

      // All subcollections inside a school:
      //   - public read (student pages need students, rewards, transactions, classes)
      //   - only teachers/admins can write
      // Exceptions below override this for rewardRequests.
      match /{collection}/{docId} {
        allow read: if true;
        allow write: if isTeacherOrAdmin(schoolId);
      }

      // Reward requests:
      //   - ANY authenticated user (including anonymous) can CREATE
      //   - Only teachers/admins can read, update, delete
      match /rewardRequests/{requestId} {
        allow create: if request.auth != null;
        allow read, update, delete: if isTeacherOrAdmin(schoolId);
      }
    }
  }
}
